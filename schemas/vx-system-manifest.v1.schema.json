{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vaixlns.example/schemas/vx-system-manifest.v1.schema.json",
  "title": "VX ONE System Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "system_id", "version", "display_name", "target", "install_policy", "artifacts"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "system_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$" },
    "version": { "type": "string", "minLength": 1 },
    "display_name": { "type": "string", "minLength": 1 },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architectures", "firmware"],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "architectures": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "firmware": { "type": "array", "minItems": 1, "items": { "enum": ["uefi", "bios", "either"] } },
        "secure_boot": { "type": "string", "enum": ["required", "recommended", "not_applicable"] },
        "tpm": { "type": "string", "enum": ["required", "recommended", "not_applicable"] }
      }
    },
    "install_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "require_human_approval", "network_enabled", "execute_install"],
      "properties": {
        "mode": { "const": "plan_only" },
        "require_human_approval": { "const": true },
        "network_enabled": { "const": false },
        "execute_install": { "const": false }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "kind", "uri", "sha256", "size_bytes", "signature"],
        "properties": {
          "artifact_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$" },
          "kind": { "enum": ["os_image", "installer", "runtime_bundle", "recovery_image"] },
          "uri": { "type": "string", "format": "uri", "pattern": "^https://" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 1, "maximum": 107374182400 },
          "signature": {
            "type": "object",
            "additionalProperties": false,
            "required": ["algorithm", "signer_id", "value"],
            "properties": {
              "algorithm": { "const": "ed25519" },
              "signer_id": { "type": "string", "minLength": 1 },
              "value": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
