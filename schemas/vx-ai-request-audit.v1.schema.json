{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fisallllll280-code/VAIXLNS-unified/blob/main/schemas/vx-ai-request-audit.v1.schema.json",
  "title": "VX AI Request Audit — Request Creation Record",
  "description": "Provider-neutral request metadata accepted by the VX AI audit ledger. Raw prompts and outputs are excluded; store only references and SHA-256 digests.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "trace_id",
    "actor_id",
    "purpose",
    "provider",
    "model_id",
    "policy_version",
    "input_hash",
    "input_classification"
  ],
  "properties": {
    "request_id": { "type": "string", "minLength": 1 },
    "trace_id": { "type": "string", "minLength": 1 },
    "parent_request_id": { "type": ["string", "null"], "minLength": 1 },
    "tenant_id": { "type": ["string", "null"], "minLength": 1 },
    "actor_id": { "type": "string", "minLength": 1 },
    "agent_id": { "type": ["string", "null"], "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "model_id": { "type": "string", "minLength": 1 },
    "model_version": { "type": ["string", "null"], "minLength": 1 },
    "policy_version": { "type": "string", "minLength": 1 },
    "created_at": { "type": ["string", "null"], "format": "date-time" },
    "input_hash": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "input_ref": { "type": ["string", "null"], "minLength": 1 },
    "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "input_classification": { "type": "string", "minLength": 1 }
  }
}
