{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vaixlns.org/schemas/research-decision-bundle.schema.json",
  "title": "VAIXLNS Research Decision Bundle",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "innovation_id",
    "mission",
    "candidate_title",
    "decision_state",
    "novelty_state",
    "sources",
    "queries",
    "search_outcomes",
    "agent_reports",
    "open_questions",
    "next_actions",
    "promotion_authorized",
    "epistemic_note"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "run_id": { "type": "string", "pattern": "^RSH-[0-9a-f]{16}$" },
    "innovation_id": { "type": "string" },
    "mission": { "type": "string", "minLength": 1 },
    "candidate_title": { "type": "string", "minLength": 1 },
    "decision_state": {
      "enum": ["BLOCKED", "NEEDS_INVESTIGATION", "ENGINEERING_GAPS", "READY_FOR_ENGINEERING_REVIEW"]
    },
    "novelty_state": { "type": "string" },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "queries": { "type": "array", "items": { "$ref": "#/$defs/query" } },
    "search_outcomes": { "type": "array", "items": { "$ref": "#/$defs/outcome" } },
    "agent_reports": { "type": "array", "items": { "$ref": "#/$defs/agentReport" } },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "next_actions": { "type": "array", "items": { "type": "string" } },
    "promotion_authorized": { "const": false },
    "epistemic_note": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["title", "uri", "content", "evidence_class", "revision", "origin_digest", "claims", "metadata", "source_id", "content_sha256"],
      "properties": {
        "title": { "type": "string" },
        "uri": { "type": "string" },
        "content": { "type": "string" },
        "evidence_class": { "enum": ["CANONICAL_SOURCE", "ARCHIVE", "IMPLEMENTATION", "TEST", "RUNTIME", "SECONDARY", "UNKNOWN"] },
        "revision": { "type": "string" },
        "origin_digest": { "type": "string" },
        "claims": { "type": "array" },
        "metadata": { "type": "object" },
        "source_id": { "type": "string", "pattern": "^SRC-[0-9a-f]{16}$" },
        "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "query": {
      "type": "object",
      "required": ["query_id", "text", "purpose", "required"],
      "properties": {
        "query_id": { "type": "string" },
        "text": { "type": "string" },
        "purpose": { "enum": ["DISCOVERY", "NOVELTY", "COUNTEREVIDENCE", "IMPLEMENTATION", "CONTRADICTION", "FAILURE_ANALYSIS"] },
        "required": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "outcome": {
      "type": "object",
      "required": ["provider_id", "query_id", "purpose", "status", "source_ids", "error"],
      "properties": {
        "provider_id": { "type": "string" },
        "query_id": { "type": "string" },
        "purpose": { "enum": ["DISCOVERY", "NOVELTY", "COUNTEREVIDENCE", "IMPLEMENTATION", "CONTRADICTION", "FAILURE_ANALYSIS"] },
        "status": { "enum": ["OK", "ERROR"] },
        "source_ids": { "type": "array", "items": { "type": "string" } },
        "error": { "type": "string" }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["code", "severity", "message", "source_refs", "blocks_readiness"],
      "properties": {
        "code": { "type": "string" },
        "severity": { "enum": ["INFO", "WARNING", "GAP", "BLOCKER"] },
        "message": { "type": "string" },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "blocks_readiness": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "agentReport": {
      "type": "object",
      "required": ["agent_id", "role", "outcome", "summary", "findings", "metrics", "work_items"],
      "properties": {
        "agent_id": { "type": "string" },
        "role": { "type": "string" },
        "outcome": { "enum": ["PASS", "WARN", "BLOCKED"] },
        "summary": { "type": "string" },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "metrics": { "type": "object", "additionalProperties": { "type": "number" } },
        "work_items": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
